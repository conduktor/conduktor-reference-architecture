# Generated by terraform (module "gw-service-accounts" + local_sensitive_file in
# provisioning/main.tf) because the password below is a Gateway-issued token
# that only exists after `make init-conduktor-platform`. Not tracked in git.
#
# Kafka client for the Gateway external listener using a Gateway-managed
# service account. The listener accepts both SASL mechanisms: PLAIN for
# service accounts Gateway issues tokens for, and OAUTHBEARER for identities
# your IdP owns (see client.properties).

# Security protocol
security.protocol=SASL_SSL
sasl.mechanism=PLAIN

# The username is the Gateway service account; the password is its token,
# signed with GATEWAY_USER_POOL_SECRET_KEY. Rotate by re-running terraform.
sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required \
    username="${username}" \
    password="${token}";

# SSL settings — the Gateway external listener uses one-way TLS
# (sslClientAuth: NONE), so the client only needs a truststore.
ssl.truststore.type=JKS
ssl.truststore.location=./truststore.jks
ssl.truststore.password=conduktor
